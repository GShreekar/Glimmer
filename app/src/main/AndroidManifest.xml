<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Exact alarm permission. USE_EXACT_ALARM is deliberately not requested: it is auto-granted
      but Play restricts it to apps whose core function IS alarms/timers/calendars, and a birthday
      reminder app is a borderline case that risks rejection at review. SCHEDULE_EXACT_ALARM is
      the standard, user-grantable alternative — see NotificationScheduler.canScheduleExactAlarms
      and requestExactAlarmPermission for the runtime grant flow this requires on API 31+.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Reschedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
      FEAT-02: only requested at runtime when the user explicitly taps "Import from Contacts" —
      never on first launch, never silently. See ImportContactsScreen / ContactsBirthdayImporter.
      The contact-linking picker in Add/Edit (FEAT-01) is separate and needs no permission at all.
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      FEAT-11: lets onboarding's reliability step offer exempting Glimmer from battery
      optimization on OEMs known for aggressively killing background work (Xiaomi, Oppo, Vivo,
      Samsung) — without it, ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS throws a SecurityException
      rather than showing the system dialog. Purely opt-in and user-initiated, same as
      SCHEDULE_EXACT_ALARM above; if this app is ever distributed on Play, its listing needs to
      declare this permission's use case under the Battery Optimization policy.
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      SEC-01: the README promises "100% Offline & Private", but the default (allowBackup=true
      with no rules) is "back everything up" — Android Auto Backup would silently upload the
      entire Room database (every contact's name, birth date, relationship, private notes) to the
      user's Google Drive. Disabled outright rather than carved up with dataExtractionRules:
      SEC-02 now encrypts the database with a passphrase kept in Android Keystore-backed storage,
      which is device-bound and does not travel in ANY backup or device-transfer flow — so even a
      selectively-included copy of the (encrypted) DB would arrive on a new device undecryptable
      and useless. FEAT-07 (a local, user-controlled encrypted export/import file) is the correct
      way to move data to a new phone; that's a feature addition, not in this fix's scope.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Glimmer.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- FEAT-03: a fired reminder's tap target is glimmer://birthday/<id>, deep-linking
                 straight to that person's Detail screen (see DetailRoute's navDeepLink in
                 GlimmerApp.kt) instead of just opening Home. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="glimmer" android:host="birthday" />
            </intent-filter>
        </activity>

        <!-- Receiver for birthday alarm notifications -->
        <receiver
            android:name="com.glimmer.app.data.BirthdayAlarmReceiver"
            android:exported="false" />

        <!--
          Reschedules alarms after events that clear or invalidate them: reboot (AlarmManager
          alarms don't survive it), an app update (MY_PACKAGE_REPLACED — some OEMs/versions clear
          exact alarms across updates), and a timezone change (every alarm's trigger time is
          computed in the device's local zone; see NotificationScheduler.scheduleReminder).
        -->
        <receiver
            android:name="com.glimmer.app.data.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- FEAT-06: the home-screen widget — see widget/BirthdayWidget.kt. -->
        <receiver
            android:name="com.glimmer.app.widget.BirthdayWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/birthday_widget_info" />
        </receiver>
    </application>

</manifest>
