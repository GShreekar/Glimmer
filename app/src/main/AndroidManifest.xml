<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Exact alarm permission. USE_EXACT_ALARM is deliberately not requested: it is auto-granted
      but Play restricts it to apps whose core function IS alarms/timers/calendars, and a birthday
      reminder app is a borderline case that risks rejection at review. SCHEDULE_EXACT_ALARM is
      the standard, user-grantable alternative — see NotificationScheduler.canScheduleExactAlarms
      and requestExactAlarmPermission for the runtime grant flow this requires on API 31+.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Reschedule alarms after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Glimmer.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Receiver for birthday alarm notifications -->
        <receiver
            android:name="com.glimmer.app.data.BirthdayAlarmReceiver"
            android:exported="false" />

        <!--
          Reschedules alarms after events that clear or invalidate them: reboot (AlarmManager
          alarms don't survive it), an app update (MY_PACKAGE_REPLACED — some OEMs/versions clear
          exact alarms across updates), and a timezone change (every alarm's trigger time is
          computed in the device's local zone; see NotificationScheduler.scheduleReminder).
        -->
        <receiver
            android:name="com.glimmer.app.data.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
