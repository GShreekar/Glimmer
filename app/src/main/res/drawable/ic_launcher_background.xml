<?xml version="1.0" encoding="utf-8"?>
<!-- Glimmer icon background: deep dark neumorphic base with subtle radial depth -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Base dark background -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="70"
                android:startColor="#1E1B2E"
                android:endColor="#13111F"/>
        </aapt:attr>
    </path>

    <!-- Subtle neumorphic highlight (top-left light source) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="20"
                android:centerY="20"
                android:gradientRadius="60"
                android:startColor="#18FFFFFF"
                android:endColor="#00FFFFFF"/>
        </aapt:attr>
    </path>

    <!-- Subtle neumorphic shadow (bottom-right) -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="88"
                android:centerY="88"
                android:gradientRadius="60"
                android:startColor="#22000000"
                android:endColor="#00000000"/>
        </aapt:attr>
    </path>
</vector>
